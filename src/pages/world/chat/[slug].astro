---
export const prerender = false;

import { getCollection } from 'astro:content';
import Grain from '../../../components/character/Grain.astro';
import Base from '../../../layouts/Base.astro';
import '../../../styles/chat.css';
import { characterSurface } from '../../../lib/character-layout.js';
import { callFrames, openingFrame } from '../../../lib/expressions.js';
import { text } from '../../../lib/locale.js';
import { isPublicStatus } from '../../../lib/publish.js';

const expressionModules = import.meta.glob('../../../content/expressions/*.json', {
  eager: true,
  import: 'default',
});
const expressions = new Map(
  Object.values(expressionModules).map((file) => [file.slug, file])
);
const galleryModules = import.meta.glob('../../../../public/data/kindred_gallery_*.json', {
  eager: true,
  import: 'default',
});

const entry = (await getCollection('characters')).find(
  (item) => item.data.slug === Astro.params.slug
);
if (!entry || !isPublicStatus(entry.data.status) || !entry.data.agent?.chat) {
  return new Response('Not found.', { status: 404, headers: { 'cache-control': 'private, no-store' } });
}
const data = entry.data;
const surface = characterSurface(data);
const name = text(data.name);
const tagline = text(data.profile.tagline);
const idle = text(data.voice.idle);
const locationNames = Object.fromEntries((await getCollection('locations')).map(item => [item.data.slug, text(item.data.name)]));
const gallery =
  Object.entries(galleryModules).find(([file]) => file.endsWith(`/kindred_gallery_${data.slug}.json`))?.[1] ??
  { images: [] };
const frames = callFrames(gallery, expressions.get(data.slug));
const opening = openingFrame(frames);
const copy = {
  adultMode: text({ en: '성인 모드' }),
  continueStart: text({ en: '계속 말하기' }),
  continueStop: text({ en: '멈추기' }),
  continueStatus: text({ en: '이야기하는 중' }),
  continueReceived: text({ en: '이어서 이야기하기' }),
  end: text({ en: 'end' }),
  you: text({ en: 'you' }),
  say: text({ en: 'say' }),
  send: text({ en: 'send' }),
  dropped: text({ en: 'The line dropped.' }),
  rejected: text({ en: "That didn't send." }),
  timeout: text({ en: 'That took too long.' }),
  unavailable: text({ en: 'No answer came back.' }),
  unanswered: text({ en: "They couldn't answer." }),
  quiet: text({ en: 'Nothing came back.' }),
  wait: text({ en: 'Wait.' }),
  memory: text({ en: 'memory' }),
  offline: text({ en: 'memory offline' }),
  thinking: text({ en: 'thinking' }),
  received: text({ en: 'message received' }),
  retrieved: text({ en: 'retrieved' }),
  webSearch: text({ en: 'web search' }),
  webSearchLabel: text({ en: 'Web search for the next message' }),
  world: text({ en: 'world' }),
  emotion: text({ en: 'emotion' }),
  reply: text({ en: 'reply' }),
  copy: text({ en: 'Copy' }),
  cancelReply: text({ en: 'Cancel reply' }),
  jumpToQuote: text({ en: 'Jump to quoted message' }),
  photo: text({ en: 'Photo' }),
  saved: text({ en: 'saved' }),
  none: text({ en: 'none' }),
  pending: text({ en: 'none yet' }),
  recent: text({ en: 'recent' }),
  queued: text({ en: 'queued' }),
  retry: text({ en: 'retry' }),
  emoji: text({ en: 'emoji' }),
  joy: text({ en: 'joy' }),
  playful: text({ en: 'playful' }),
  calm: text({ en: 'calm' }),
  shy: text({ en: 'shy' }),
  sad: text({ en: 'sad' }),
  intense: text({ en: 'intense' }),
  tired: text({ en: 'tired' }),
};
---

<Base
  frame="character"
  title={`${name} — kinxdred`}
  description={tagline}
  robots="noindex"
  accent={surface.accent}
  ground={surface.ground}
  ink={surface.ink}
>
  <div class="call" data-layout={surface.layout} data-slug={data.slug}>
    <Grain />
    <a class="call-brand" href="/">kinxdred</a>
    <main class="call-column">
      <header class="call-bar">
        <a class="call-icon" href="/world/admin" aria-label="Back to hub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg></a>
        <button class="call-avatar" id="call-avatar" type="button" aria-label={`View ${name} photo`}>
          {opening ? <img id="call-avatar-image" src={opening.src} alt={opening.title || name} /> : name.slice(0, 1)}
        </button>
        <div class="call-meta"><h1 class="call-name">{name}</h1><p class="call-presence"><b id="call-mood">calm</b><span id="call-location"></span></p></div>
        <button class="call-icon" id="call-memory-toggle" type="button" aria-label="Memory" aria-controls="call-sheet-panel" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><g fill="currentColor" stroke="none"><circle cx="9" cy="8" r="1"/><circle cx="16" cy="10" r="1"/><circle cx="8" cy="14" r="1"/><circle cx="13" cy="16" r="1"/><circle cx="12" cy="11" r="1"/></g></svg></button>
      </header>
      <div class="call-thread">
        <ol class="call-log" id="call-log" aria-label={`${name} conversation`}>
          {idle ? <li class="call-empty" id="call-empty">{idle}</li> : null}
        </ol>
        <button class="call-jump" id="call-jump" type="button" hidden>New message ↓</button>
      </div>
      <p class="call-status" id="call-status" role="status"></p>
      <span class="call-sr" id="call-reply-status" role="status"></span>
      <div class="call-reply-bar" id="call-reply-bar" hidden>
        <span class="call-reply-mark" aria-hidden="true">↶</span>
        <div class="call-reply-summary"><b></b><span></span></div>
        <button class="call-icon" id="call-reply-cancel" type="button" aria-label={copy.cancelReply}>×</button>
      </div>
      <div class="call-search-status" id="call-search-status" role="status" hidden><span>{copy.webSearch}</span></div>
      <div class="call-reply-menu" id="call-reply-menu" role="menu" aria-label="Message actions" hidden>
        <button type="button" role="menuitem" data-action="reply">↶ <span>Reply</span></button>
        <button type="button" role="menuitem" data-action="copy">▢ <span>{copy.copy}</span></button>
      </div>
      <div class="call-continue-bar" id="call-continue-bar" hidden>
        <span role="status">{copy.continueStatus}</span>
        <button id="call-continue-stop" type="button">{copy.continueStop}</button>
      </div>
      <div class="call-continue-controls">
        <button id="call-continue-start" type="button">{copy.continueStart}</button>
        {data.slug === 'dred' && (
          <button type="button" class="call-adult-mode" id="call-adult-mode" aria-pressed="false">
            {copy.adultMode}
          </button>
        )}
      </div>
      <form class="call-form" id="call-form" novalidate>
        <button type="button" class="call-search call-icon" id="call-search" aria-pressed="false" aria-label={copy.webSearchLabel}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg></button>
        <label class="call-field"><span class="call-sr">Message</span><textarea id="call-input" name="message" rows="1" autocomplete="off" autocorrect="on" autocapitalize="sentences" spellcheck="true" enterkeyhint="send" inputmode="text" data-1p-ignore data-lpignore="true" maxlength="2000" placeholder="Message"></textarea></label>
        <button class="call-send call-icon" type="submit" disabled aria-label="Send"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6"/></svg></button>
      </form>
    </main>
    <div class="call-sheet" id="call-sheet">
      <button type="button" class="call-sheet-scrim" data-close aria-label="Close memory"></button>
      <section class="call-sheet-panel" id="call-sheet-panel" aria-label="Memory" tabindex="-1">
        <button type="button" class="call-sheet-handle" id="call-sheet-handle" aria-label="Resize memory, drag down to close"></button>
        <div class="call-memory-heading"><h2>Memory</h2><button type="button" data-close>Close</button></div>
        <p class="call-memory-hint"><span class="call-hint-mobile">Pinch to zoom · drag to turn · double-tap a region</span><span class="call-hint-desktop">Scroll to zoom · drag to turn</span></p>
        <p class="call-sr" id="call-sphere-help">Drag to rotate. Pinch or scroll to zoom. Double-tap a region to zoom; repeat to reset. Zoom buttons are also available.</p>
        <div class="call-memory" id="call-memory">
          <div class="call-memory-view" id="call-memory-view" aria-describedby="call-sphere-help"></div>
          <p class="call-memory-status" id="call-memory-status" hidden>{copy.offline}</p>
        </div>
        <div class="call-zoom"><button type="button" data-zoom="out" aria-label="Zoom out">−</button><button type="button" data-zoom="in" aria-label="Zoom in">+</button><button type="button" data-zoom="reset" aria-label="Reset zoom">Reset</button></div>
        <details class="call-debug"><summary>{copy.thinking}</summary><div class="call-think" id="call-think"></div></details>
      </section>
    </div>
    <dialog class="call-viewer" id="call-viewer" aria-label="Photo viewer" aria-modal="true">
      <button class="call-viewer-close" type="button" aria-label="Close photo">Close</button>
      <div class="call-viewer-stage"><img alt="" draggable="false" /></div>
      <p>Pinch or scroll to zoom · swipe down to close</p>
    </dialog>
  </div>
</Base>

<script define:vars={{ slug: data.slug, name, frames, copy, locationNames }}>
  window.__kindredCall = { slug, name, frames, copy, locationNames };
</script>
<script>
  import { mountCall } from '../../../scripts/call-chat.js';

  mountCall(window.__kindredCall);
</script>

<script>
  import { mountCallSheet } from '../../../scripts/call-sheet.js';

  mountCallSheet();
</script>

<script>
  import { mountSphere } from '../../../scripts/memory-sphere.js';

  const call = document.querySelector('.call');
  const view = document.querySelector('#call-memory-view');
  const offline = document.querySelector('#call-memory-status');
  if (call && view) {
    const style = getComputedStyle(document.documentElement);
    mountSphere(view, call, {
      accent: style.getPropertyValue('--accent').trim(),
      ground: style.getPropertyValue('--ground').trim(),
      layout: call.dataset.layout,
      reduced: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
    })
      .then((api) => {
        if (!api) {
          if (offline) offline.hidden = false;
          return;
        }
        const apply = (detail) => api.setMap(detail);
        call.addEventListener('memory-map', (event) => apply(event.detail));
        call.addEventListener('memory-trace', (event) => api.showRetrieved(event.detail?.items || []));
        call.addEventListener('memory-focus', (event) => api.focus(event.detail?.id || ''));
        if (call.memoryMap) apply(call.memoryMap);
      })
      .catch(() => {
        if (offline) offline.hidden = false;
      });
  }
</script>

<script>
  import { attachImeEnterGuard } from '../../../lib/ime-enter.js';

  const callInput = document.querySelector('#call-input');
  const callForm = document.querySelector('#call-form');
  if (callInput && callForm) attachImeEnterGuard(callInput, callForm);
</script>
