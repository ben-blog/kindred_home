---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { text } from '../../lib/locale.js';
import { compareEntries, isPublicStatus } from '../../lib/publish.js';

const works = (await getCollection('works'))
  .filter((entry) => isPublicStatus(entry.data.status))
  .sort(compareEntries);
---

<Base title="Works — kinxdred" description="Works in the kinxdred world.">
  <p class="eyebrow">works</p>
  <h1>Works</h1>
  <ul class="links">
    {
      works.map((entry) => (
        <li>
          <a href={`/works/${entry.data.slug}/`}>
            <span>{text(entry.data.title)}</span>
            <span class="meta">{entry.data.url}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
