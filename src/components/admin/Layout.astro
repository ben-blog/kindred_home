---
const { title } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title} — kinxdred</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Mono:wght@300;400&family=Noto+Sans+KR:wght@400;500&display=swap" />
  </head>
  <body class="admin">
    <div id="grain" aria-hidden="true"></div>
    <header class="bar">
      <a href="/">kinxdred</a>
      <nav aria-label="관리자"><a class:list={{ on: title === 'Hub' }} href="/world/admin">hub</a><a href="/world">world</a><button type="button" id="sign-out">나가기</button></nav>
    </header>
    <main><slot /></main>
    <slot name="bottom" />
  </body>
</html>
<script>
  import { adminCopy as copy } from '../../lib/admin-copy.js';
  document.querySelector('#sign-out')?.addEventListener('click', async () => {
    try {
      const response = await fetch('/api/world/auth/session', { method: 'DELETE' });
      if (!response.ok) throw new Error();
      location.replace('/login');
    } catch {
      const status = document.querySelector('[data-admin-message]');
      if (status) { status.textContent = copy.signOutFail; status.removeAttribute('hidden');
        const bar = status.closest('.error'); if (bar) bar.removeAttribute('hidden'); }
    }
  });
</script>
