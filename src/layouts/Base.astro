---
import '../styles/site.css';

const { title, description, accent = '', ground = '', ink = '', frame = 'site', robots = '' } = Astro.props;
const parts = [];
if (/^#[0-9A-Fa-f]{6}$/.test(accent)) parts.push(`--accent:${accent}`);
if (/^#[0-9A-Fa-f]{6}$/.test(ground)) parts.push(`--ground:${ground}`);
if (ink === '#080806' || ink === 'rgba(255,255,255,.92)') parts.push(`--ink:${ink}`);
const style = parts.join(';');
const character = frame === 'character';
const world = frame === 'world';
const bare = character || world;
---

<!doctype html>
<html
  lang="en"
  class={character ? 'frame-character' : world ? 'frame-world' : undefined}
  style={character ? style : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <script src="/js/site-base.js" is:inline></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Mono:wght@300;400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style={bare ? undefined : style}>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <header class="top">
            <a href="/">kinxdred</a>
            <nav>
              <a href="/characters">characters</a>
              <a href="/works">works</a>
            </nav>
          </header>
          <main>
            <slot />
          </main>
        </>
      )
    }
  </body>
</html>
