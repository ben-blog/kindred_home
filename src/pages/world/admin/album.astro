---
export const prerender = false;

import { getCollection } from 'astro:content';
import Layout from '../../../components/admin/Layout.astro';
import { adminCopy as copy } from '../../../lib/admin-copy.js';
import '../../../styles/admin.css';
import { memoryEmotions } from '../../../config/memory-emotions.js';
import { text } from '../../../lib/locale.js';
import { isPublicStatus } from '../../../lib/publish.js';

const people = (await getCollection('characters'))
  .filter((entry) => isPublicStatus(entry.data.status) && entry.data.agent?.album)
  .sort((a, b) => a.data.slug.localeCompare(b.data.slug));

const fields = [
  ['title', copy.title],
  ['technique', copy.technique],
  ['description', copy.description],
  ['kin_perspective', 'KIN 시점'],
  ['dred_perspective', 'DRED 시점'],
];
---

<Layout title="앨범">
    <div class="album">
      <p class="eyebrow">leader album</p>
      <h1>{copy.album}</h1>
      <div id="studio">
        <form class="panel" id="upload-form">
          <label class="eyebrow" for="album-character">{copy.character}</label>
          <select id="album-character" name="character" required>
            {
              people.map((entry) => (
                <option value={entry.data.slug}>{text(entry.data.name)}</option>
              ))
            }
          </select>
          <label class="eyebrow" for="album-file">{copy.picture}</label>
          <input id="album-file" name="image" type="file" accept="image/png,image/jpeg,image/webp" required />
          <label class="eyebrow" for="album-note">{copy.note}</label>
          <input id="album-note" name="note" type="text" maxlength="200" placeholder="선택, 한 줄" />
          <div class="world-actions">
            <button class="btn ghost" type="submit">{copy.upload}</button>
          </div>
        </form>
        <div class="album-tabs" role="tablist" aria-label="앨범 상태">
          <button class="btn ghost" role="tab" data-tab="pending" aria-selected="true">검토 대기</button>
          <button class="btn ghost" role="tab" data-tab="published" aria-selected="false">게시됨</button>
          <button class="btn ghost" role="tab" data-tab="rejected" aria-selected="false">거절됨</button>
        </div>
        <ul class="album-list" id="album-list"></ul>
        <form class="panel" id="review" hidden>
          <img class="album-preview" id="review-image" alt="" />
          <p class="meta" id="review-meta"></p>
          <label class="eyebrow" for="field-style">style</label>
          <input id="field-style" maxlength="80" />
          <label class="eyebrow" for="field-tags">tags</label>
          <textarea id="field-tags" placeholder="한국어 | english"></textarea>
          <div class="album-columns">
            <div>
              <p class="eyebrow">ko</p>
              {
                fields.map(([key, label]) => (
                  <label class="eyebrow" for={`ko-${key}`}>
                    {label}
                    <textarea id={`ko-${key}`} data-locale="ko" data-key={key}></textarea>
                  </label>
                ))
              }
            </div>
            <div>
              <p class="eyebrow">en</p>
              {
                fields.map(([key, label]) => (
                  <label class="eyebrow" for={`en-${key}`}>
                    {label}
                    <textarea id={`en-${key}`} data-locale="en" data-key={key}></textarea>
                  </label>
                ))
              }
            </div>
          </div>
          <label class="eyebrow" for="field-summary">felt memory</label>
          <textarea id="field-summary" maxlength="600"></textarea>
          <label class="eyebrow" for="field-emotion">emotion</label>
          <select id="field-emotion">
            {memoryEmotions.map((emotion) => <option value={emotion}>{emotion}</option>)}
          </select>
          <label class="eyebrow" for="field-intensity">intensity</label>
          <input id="field-intensity" type="number" min="0" max="1" step="0.01" />
          <label class="eyebrow" for="field-reason">{copy.reason}</label>
          <input id="field-reason" maxlength="180" />
          <label class="eyebrow" for="field-main">
            <input id="field-main" type="checkbox" /> {copy.main}
          </label>
          <div class="world-actions">
            <button class="btn ghost" type="button" id="save">{copy.save}</button>
            <button class="btn ghost" type="button" id="regenerate">{copy.regenerate}</button>
            <button class="btn ghost" type="button" id="publish">{copy.publish}</button>
          </div>
          <label class="eyebrow" for="reject-reason">{copy.reason}</label>
          <input id="reject-reason" maxlength="500" />
          <div class="world-actions">
            <button class="btn ghost" type="button" id="reject">{copy.rejectConfirm}</button>
          </div>
        </form>
      </div>
      <p class="world-status" id="album-status" data-admin-message aria-live="polite"></p>
    </div>
</Layout>

<script>
  import { adminCopy as copy, adminMessage, relativeTime } from '../../../lib/admin-copy.js';
  const status = document.querySelector('#album-status');
  const uploadForm = document.querySelector('#upload-form');
  const list = document.querySelector('#album-list');
  const review = document.querySelector('#review');
  review.addEventListener('submit', (event) => event.preventDefault());
  const reviewImage = document.querySelector('#review-image');
  const reviewMeta = document.querySelector('#review-meta');

  const jsonHeaders = { 'content-type': 'application/json', accept: 'application/json' };
  let current = null;
  let busy = false;

  function say(text) {
    status.textContent = text;
  }

  async function readBody(response) {
    if ([401, 403].includes(response.status)) location.replace('/login?next=/world/admin/album');
    return response.json().catch(() => ({}));
  }

  function detail(body, fallback) {
    return adminMessage(copy.fail, { detail: body.detail || fallback });
  }

  let rows = [];
  let tab = 'pending';
  let initialItem = new URLSearchParams(location.search).get('id');
  async function loadList() {
    const response = await fetch('/api/world/album', { headers: { accept: 'application/json' } });
    if ([401, 403].includes(response.status)) { location.replace('/login?next=/world/admin/album'); return; }
    if (!response.ok) throw new Error(`앨범 목록 (${response.status})`);
    const body = await readBody(response);
    rows = body.submissions || [];
    if (initialItem) {
      const item = rows.find((row) => row.id === initialItem);
      if (item) {
        tab = ['published', 'rejected'].includes(item.status) ? item.status : 'pending';
        openItem(item);
      } else say('사진을 찾을 수 없습니다.');
      initialItem = null;
    }
    renderList();
  }
  function renderList() {
    const pending = rows.filter((row) => ['drafted', 'generated'].includes(row.status)).length;
    for (const button of document.querySelectorAll('[data-tab]')) {
      button.setAttribute('aria-selected', String(button.dataset.tab === tab));
      if (button.dataset.tab === 'pending') button.textContent = `${copy.queue} ${pending}`;
    }
    list.replaceChildren();
    const visible = rows.filter((row) => tab === 'pending' ? ['drafted', 'generated'].includes(row.status) : row.status === tab)
      .sort((a, b) => tab === 'pending' ? new Date(a.createdAt) - new Date(b.createdAt) : new Date(b.updatedAt) - new Date(a.updatedAt));
    for (const item of visible) {
      const entry = document.createElement('li');
      const button = document.createElement('button'); button.type = 'button';
      button.setAttribute('aria-current', String(item.id === current?.id));
      const thumb = document.createElement('span'); thumb.className = 'thumb';
      if (item.ready) {
        const image = document.createElement('img'); image.src = `/api/world/album/${encodeURIComponent(item.id)}/file`; image.alt = ''; image.loading = 'lazy'; thumb.append(image);
      }
      const label = document.createElement('span');
      label.textContent = item.caption?.ko?.title || item.caption?.en?.title || copy.untitled;
      const meta = document.createElement('small');
      const tag = document.createElement('span'); tag.className = `tag ${item.status === 'generated' ? 'ready' : ''}`; tag.textContent = item.status;
      meta.append(tag, `${item.character} · ${relativeTime(item.createdAt)}`); label.append(meta);
      button.append(thumb, label);
      button.addEventListener('click', () => { openItem(item); renderList(); });
      entry.append(button); list.append(entry);
    }
    if (!visible.length) { const empty = document.createElement('li'); empty.textContent = tab === 'pending' ? copy.noReview : '사진이 없습니다'; list.append(empty); }
  }
  for (const button of document.querySelectorAll('[data-tab]')) {
    button.addEventListener('click', () => { tab = button.dataset.tab; renderList(); });
    button.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      const tabs = [...document.querySelectorAll('[data-tab]')];
      const next = tabs[(tabs.indexOf(button) + (event.key === 'ArrowRight' ? 1 : 2)) % tabs.length];
      next.focus(); next.click();
    });
  }

  function setFields(caption) {
    document.querySelector('#field-style').value = caption?.style || '';
    document.querySelector('#field-tags').value = (caption?.tags || [])
      .map((tag) => `${tag.name_ko} | ${tag.name_en}`)
      .join('\n');
    for (const node of review.querySelectorAll('[data-locale]')) {
      const block = caption?.[node.dataset.locale] || {};
      node.value = block[node.dataset.key] || '';
    }
    document.querySelector('#field-summary').value = caption?.felt?.summary || '';
    document.querySelector('#field-emotion').value = caption?.felt?.emotion?.label || 'calm';
    document.querySelector('#field-intensity').value =
      caption?.felt?.emotion?.intensity ?? '';
    document.querySelector('#field-reason').value = caption?.felt?.emotion?.reason || '';
    document.querySelector('#field-main').checked = caption?.show_on_main === true;
  }

  function readCaption() {
    const block = (locale) => {
      const out = {};
      for (const node of review.querySelectorAll(`[data-locale="${locale}"]`)) {
        out[node.dataset.key] = node.value;
      }
      return out;
    };
    const tags = document
      .querySelector('#field-tags')
      .value.split('\n')
      .map((line) => line.trim())
      .filter(Boolean)
      .map((line) => {
        const [ko, en] = line.split('|');
        return { name_ko: (ko || '').trim(), name_en: (en || ko || '').trim() };
      });
    return {
      style: document.querySelector('#field-style').value,
      tags,
      ko: block('ko'),
      en: block('en'),
      felt: {
        summary: document.querySelector('#field-summary').value,
        emotion: {
          label: document.querySelector('#field-emotion').value,
          intensity: Number(document.querySelector('#field-intensity').value),
          reason: document.querySelector('#field-reason').value,
        },
      },
      show_on_main: document.querySelector('#field-main').checked,
    };
  }

  function openItem(item) {
    current = item;
    const url = new URL(location.href); url.searchParams.set('id', item.id); history.replaceState(null, '', url);
    document.querySelector('#reject-reason').value = '';

    review.hidden = false;
    reviewImage.hidden = !item.ready;
    if (item.ready) reviewImage.src = `/api/world/album/${encodeURIComponent(item.id)}/file`;
    else reviewImage.removeAttribute('src');
    reviewImage.alt = item.caption?.en?.title || item.character;
    reviewMeta.textContent = [item.character, item.status, item.leaderNote, item.reviewerNote]
      .filter(Boolean)
      .join(' · ');
    setFields(item.caption);
    const locked = item.status !== 'generated';
    for (const node of review.querySelectorAll('input, textarea, select')) {
      if (node.id === 'reject-reason') continue;
      node.disabled = locked;
    }
    document.querySelector('#save').disabled = locked;
    document.querySelector('#publish').disabled = locked;
    document.querySelector('#regenerate').disabled = !(
      item.ready && (item.status === 'drafted' || item.status === 'generated')
    );
    document.querySelector('#reject').disabled = !(item.status === 'drafted' || item.status === 'generated');
  }

  async function upload(file, character, note) {
    const created = await fetch('/api/world/album', {
      method: 'POST',
      headers: jsonHeaders,
      body: JSON.stringify({ character, note, type: file.type, bytes: file.size }),
    });
    const createdBody = await readBody(created);
    if (!created.ok) throw new Error(detail(createdBody, '업로드 시작 실패'));
    const size = createdBody.chunkBytes;
    for (let index = 0, offset = 0; offset < file.size; index += 1) {
      const piece = file.slice(offset, offset + size);
      const sent = await fetch(`/api/world/album/${createdBody.id}/chunk?index=${index}`, {
        method: 'PUT',
        headers: { 'content-type': 'application/octet-stream' },
        body: piece,
      });
      if (!sent.ok) {
        const body = await readBody(sent);
        throw new Error(detail(body, '사진 전송 실패'));
      }
      offset += size;
    }
    const received = await fetch(`/api/world/album/${createdBody.id}/receive`, { method: 'POST' });
    const receivedBody = await readBody(received);
    if (!received.ok) throw new Error(detail(receivedBody, '사진 저장 실패'));
    const generated = await fetch(`/api/world/album/${createdBody.id}/generate`, { method: 'POST' });
    const generatedBody = await readBody(generated);
    await loadList();
    if (!generated.ok) {
      openItem(receivedBody);
      throw new Error(detail(generatedBody, '캡션 생성 실패. 다시 써 주세요.'));
    }
    openItem(generatedBody);
    say(copy.captionReady);
  }

  const params = new URLSearchParams(location.search);
  const hash = new URLSearchParams(location.hash.replace(/^#/, ''));
  const handed =
    params.has('token_hash') ||
    params.has('code') ||
    params.has('error') ||
    hash.has('access_token') ||
    hash.has('error') ||
    hash.has('error_code');
  if (handed) {
    const target = new URL('/auth/callback', location.origin);
    params.forEach((value, key) => {
      if (key !== 'next') target.searchParams.append(key, value);
    });
    target.searchParams.set('next', '/world/admin/album');
    target.hash = location.hash;
    location.replace(target.toString());
  }

  if (!handed) {
    try {
      await loadList();
    } catch {
      say(adminMessage(copy.fail, { detail: '서버 응답 없음' }));
    }
  }

  uploadForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy) return;
    const file = document.querySelector('#album-file').files[0];
    if (!file) return;
    busy = true;
    say(copy.uploading);
    try {
      await upload(
        file,
        document.querySelector('#album-character').value,
        document.querySelector('#album-note').value
      );
    } catch (error) {
      say(error.message || '업로드 실패');
    }
    busy = false;
  });

  async function postCaption(path, caption) {
    const response = await fetch(path, {
      method: 'POST',
      headers: jsonHeaders,
      body: JSON.stringify(caption ? { caption } : {}),
    });
    const body = await readBody(response);
    if (!response.ok) throw new Error(detail(body, '서버 요청 실패'));
    return body;
  }

  document.querySelector('#save').addEventListener('click', async () => {
    if (!current || busy) return;
    busy = true;
    say(copy.saving);
    try {
      const response = await fetch(`/api/world/album/${current.id}`, {
        method: 'PATCH',
        headers: jsonHeaders,
        body: JSON.stringify({ caption: readCaption() }),
      });
      const body = await readBody(response);
      if (!response.ok) throw new Error(detail(body, '캡션에 빠진 항목이 있습니다'));
      openItem(body);
      await loadList();
      say(copy.saved);
    } catch (error) {
      say(error.message);
    }
    busy = false;
  });

  document.querySelector('#regenerate').addEventListener('click', async () => {
    if (!current || busy) return;
    busy = true;
    say(copy.writing);
    try {
      const response = await fetch(`/api/world/album/${current.id}/generate`, { method: 'POST' });
      const body = await readBody(response);
      if (!response.ok) throw new Error(detail(body, '캡션 생성 실패. 다시 써 주세요.'));
      openItem(body);
      await loadList();
      say(copy.captionReady);
    } catch (error) {
      say(error.message);
    }
    busy = false;
  });

  document.querySelector('#publish').addEventListener('click', async () => {
    if (!current || busy) return;
    if (!confirm(copy.confirmPublish)) return;
    busy = true;
    say(copy.publishing);
    try {
      const body = await postCaption(`/api/world/album/${current.id}/publish`, readCaption());
      say(copy.published);
      await loadList();
      if (body.status) openItem({ ...current, status: 'published', galleryItemId: body.itemId, ready: true });
    } catch (error) {
      say(error.message);
      await loadList();
    }
    busy = false;
  });

  document.querySelector('#reject').addEventListener('click', async () => {
    if (!current || busy) return;
    const reason = document.querySelector('#reject-reason').value.trim();
    if (!reason) {
      say(copy.reasonRequired);
      return;
    }
    busy = true;
    say(copy.saving);
    try {
      const response = await fetch(`/api/world/album/${current.id}/reject`, {
        method: 'POST',
        headers: jsonHeaders,
        body: JSON.stringify({ reason }),
      });
      const body = await readBody(response);
      if (!response.ok) throw new Error(detail(body, '서버 요청 실패'));
      openItem(body);
      await loadList();
      say(copy.rejected);
    } catch (error) {
      say(error.message);
    }
    busy = false;
  });
</script>
