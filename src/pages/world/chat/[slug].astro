---
export const prerender = false;

import { getCollection } from 'astro:content';
import Grain from '../../../components/character/Grain.astro';
import Base from '../../../layouts/Base.astro';
import { characterSurface } from '../../../lib/character-layout.js';
import { callFrames, openingFrame } from '../../../lib/expressions.js';
import { text } from '../../../lib/locale.js';
import { isPublicStatus } from '../../../lib/publish.js';

const expressionModules = import.meta.glob('../../../content/expressions/*.json', {
  eager: true,
  import: 'default',
});
const expressions = new Map(
  Object.values(expressionModules).map((file) => [file.slug, file])
);
const galleryModules = import.meta.glob('../../../../public/data/kindred_gallery_*.json', {
  eager: true,
  import: 'default',
});

const entry = (await getCollection('characters')).find(
  (item) => item.data.slug === Astro.params.slug
);
if (!entry || !isPublicStatus(entry.data.status) || !entry.data.agent?.chat) {
  return new Response('Not found.', { status: 404, headers: { 'cache-control': 'private, no-store' } });
}
const data = entry.data;
const surface = characterSurface(data);
const name = text(data.name);
const tagline = text(data.profile.tagline);
const idle = text(data.voice.idle);
const gallery =
  Object.entries(galleryModules).find(([file]) => file.endsWith(`/kindred_gallery_${data.slug}.json`))?.[1] ??
  { images: [] };
const frames = callFrames(gallery, expressions.get(data.slug));
const opening = openingFrame(frames);
const copy = {
  end: text({ en: 'end' }),
  you: text({ en: 'you' }),
  say: text({ en: 'say' }),
  send: text({ en: 'send' }),
  dropped: text({ en: 'The line dropped.' }),
  rejected: text({ en: "That didn't send." }),
  timeout: text({ en: 'That took too long.' }),
  unavailable: text({ en: 'No answer came back.' }),
  unanswered: text({ en: "They couldn't answer." }),
  quiet: text({ en: 'Nothing came back.' }),
  wait: text({ en: 'Wait.' }),
  memory: text({ en: 'memory' }),
  offline: text({ en: 'memory offline' }),
  thinking: text({ en: 'thinking' }),
  received: text({ en: 'message received' }),
  retrieved: text({ en: 'retrieved' }),
  webSearch: text({ en: 'web search' }),
  webSearchLabel: text({ en: 'Web search for the next message' }),
  world: text({ en: 'world' }),
  emotion: text({ en: 'emotion' }),
  reply: text({ en: 'reply' }),
  saved: text({ en: 'saved' }),
  none: text({ en: 'none' }),
  pending: text({ en: 'none yet' }),
  recent: text({ en: 'recent' }),
  queued: text({ en: 'queued' }),
  retry: text({ en: 'retry' }),
  emoji: text({ en: 'emoji' }),
  joy: text({ en: 'joy' }),
  playful: text({ en: 'playful' }),
  calm: text({ en: 'calm' }),
  shy: text({ en: 'shy' }),
  sad: text({ en: 'sad' }),
  intense: text({ en: 'intense' }),
  tired: text({ en: 'tired' }),
};
---

<Base
  frame="character"
  title={`${name} — kinxdred`}
  description={tagline}
  robots="noindex"
  accent={surface.accent}
  ground={surface.ground}
  ink={surface.ink}
>
  <div class="call" data-layout={surface.layout} data-slug={data.slug}>
    <Grain />
    <header class="call-bar">
      <a href="/">kinxdred</a>
      <a href="/characters">characters</a>
      <p class="call-name">{name}</p>
      <time id="call-timer" datetime="PT0S">00:00</time>
      <a href="/world/brain">brain</a>
      <a class="call-end" href="/world/admin">{copy.end}</a>
    </header>
    <section class="call-stage" data-mood="calm" aria-label={name}>
      {
        opening ? (
          <>
            <img class="call-photo is-shown" src={opening.src} alt={opening.title || name} />
            <img class="call-photo" src={opening.src} alt="" aria-hidden="true" />
          </>
        ) : null
      }
      <p class="call-caption">{tagline}</p>
      <div class="call-self"><span>{copy.you}</span></div>
      <div class="call-memory" id="call-memory">
        <button type="button" class="call-tool" id="call-memory-toggle">{copy.memory}</button>
        <div class="call-memory-view" id="call-memory-view"></div>
        <p class="call-memory-status" id="call-memory-status" hidden>{copy.offline}</p>
      </div>
    </section>
    <section class="call-side">
      <div class="call-tools">
        <button type="button" class="call-tool" id="call-think-toggle">{copy.thinking}</button>
      </div>
      <div class="call-think" id="call-think" hidden></div>
      <ol class="call-log" id="call-log">
        {idle ? <li class="call-empty" id="call-empty">{idle}</li> : null}
      </ol>
      <form class="call-form" id="call-form" novalidate>
        <label class="call-label" for="call-input">{copy.say}</label>
        <div class="call-compose">
          <textarea id="call-input" name="message" rows="2" maxlength="2000"></textarea>
          <button
            type="button"
            class="call-emoji"
            id="call-emoji"
            aria-expanded="false"
            aria-controls="call-emoji-panel"
            aria-label={copy.emoji}
          >
            <span aria-hidden="true">😊</span>
          </button>
        </div>
        <div
          class="call-emoji-panel"
          id="call-emoji-panel"
          hidden
          role="dialog"
          aria-label={copy.emoji}
        >
        </div>
        <div class="call-actions">
          <button
            type="button"
            class="call-search"
            id="call-search"
            aria-pressed="false"
            aria-label={copy.webSearchLabel}
          >
            {copy.webSearch}
          </button>
          <button class="call-send" type="submit">{copy.send}</button>
        </div>
      </form>
      <p class="call-status" id="call-status" aria-live="polite"></p>
    </section>
    <div class="call-sheet" id="call-sheet" hidden>
      <button type="button" class="call-sheet-scrim" data-close aria-label="close"></button>
      <div
        class="call-sheet-panel"
        id="call-sheet-panel"
        role="dialog"
        aria-modal="true"
        aria-label={copy.memory}
      >
        <button type="button" class="call-sheet-handle" id="call-sheet-handle" aria-label={copy.memory}></button>
        <div class="call-sheet-tabs" role="tablist">
          <button type="button" role="tab" id="call-sheet-tab-sphere" aria-selected="true">{copy.memory}</button>
          <button type="button" role="tab" id="call-sheet-tab-trace" aria-selected="false">{copy.thinking}</button>
        </div>
        <div class="call-sheet-body">
          <div class="call-sheet-sphere" id="call-sheet-sphere" role="tabpanel"></div>
          <div class="call-sheet-trace" id="call-sheet-trace" role="tabpanel" hidden></div>
        </div>
      </div>
    </div>
  </div>
</Base>

<script define:vars={{ slug: data.slug, name, frames, copy }}>
  window.__kindredCall = { slug, name, frames, copy };
</script>
<script>
  import { mountCall } from '../../../scripts/call-chat.js';

  mountCall(window.__kindredCall);
</script>

<script>
  import { mountCallSheet } from '../../../scripts/call-sheet.js';

  mountCallSheet();
</script>

<script>
  import { mountSphere } from '../../../scripts/memory-sphere.js';

  const call = document.querySelector('.call');
  const view = document.querySelector('#call-memory-view');
  const offline = document.querySelector('#call-memory-status');
  if (call && view) {
    const style = getComputedStyle(document.documentElement);
    mountSphere(view, call, {
      accent: style.getPropertyValue('--accent').trim(),
      ground: style.getPropertyValue('--ground').trim(),
      layout: call.dataset.layout,
      reduced: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
    })
      .then((api) => {
        if (!api) {
          if (offline) offline.hidden = false;
          return;
        }
        const apply = (detail) => api.setMap(detail);
        call.addEventListener('memory-map', (event) => apply(event.detail));
        call.addEventListener('memory-trace', (event) => api.showRetrieved(event.detail?.items || []));
        call.addEventListener('memory-focus', (event) => api.focus(event.detail?.id || ''));
        if (call.memoryMap) apply(call.memoryMap);
      })
      .catch(() => {
        if (offline) offline.hidden = false;
      });
  }
</script>

<script>
  import { attachImeEnterGuard } from '../../../lib/ime-enter.js';

  const callInput = document.querySelector('#call-input');
  const callForm = document.querySelector('#call-form');
  if (callInput && callForm) attachImeEnterGuard(callInput, callForm);
</script>
