---
export const prerender = false;

import { getCollection } from 'astro:content';
import Grain from '../../components/character/Grain.astro';
import Base from '../../layouts/Base.astro';
import { text } from '../../lib/locale.js';
import { isPublicStatus } from '../../lib/publish.js';

const people = (await getCollection('characters'))
  .filter(
    (entry) =>
      isPublicStatus(entry.data.status) && entry.data.agent?.memory && entry.data.agent?.chat
  )
  .sort((a, b) => a.data.slug.localeCompare(b.data.slug))
  .map((entry) => ({
    slug: entry.data.slug,
    name: text(entry.data.name),
    accent: entry.data.identity.color,
  }));
---

<Base frame="character" title="Brain — kinxdred" description="Leader memory map." robots="noindex">
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500&display=swap"
  />
  <div class="brain-chooser">
    <Grain />
    <header class="brain-bar">
      <a href="/">kinxdred</a>
      <a class="brain-hub" href="/world/admin">hub</a>
      <a href="/world">world</a>
    </header>
    <div class="brain-body">
      <p class="brain-kicker">leader</p>
      <h1>Brain</h1>
      <p class="brain-note">한 캐릭터의 memory만 엽니다.</p>
      <div class="brain-choices">
        {
          people.map((person) => (
            <a class="hub-card" href={`/world/brain/${person.slug}/`}>
              <span>brain</span>
              <strong style={`color:${person.accent}`}>{person.name}</strong>
              <p>이 캐릭터의 history.</p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Base>

<script define:vars={{ slugs: people.map((person) => person.slug) }}>
  let last = '';
  try {
    last = localStorage.getItem('kindred-brain-slug') || '';
  } catch {
    last = '';
  }
  if (typeof last === 'string' && slugs.includes(last)) location.replace(`/world/brain/${last}/`);
</script>
