---
import { getCollection } from 'astro:content';
import Frame from '../../components/world/Frame.astro';
import Base from '../../layouts/Base.astro';
import { text } from '../../lib/locale.js';
import { isPublicStatus } from '../../lib/publish.js';

const calls = (await getCollection('characters'))
  .filter((entry) => isPublicStatus(entry.data.status) && entry.data.agent?.chat)
  .sort((a, b) => a.data.slug.localeCompare(b.data.slug));
---

<Base frame="world" title="Hub — kinxdred" description="Leader hub for kinxdred." robots="noindex">
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500&display=swap"
  />
  <div class="hub">
    <p class="eyebrow">Ben hub</p>
    <h1>Hub</h1>
    <p class="world-copy">리더만 들어오는 자리입니다.</p>
    <div class="hub-grid">
      <a class="hub-card" href="/world">
        <span>world</span>
        <strong>세계</strong>
        <p>지금 tick과 자리.</p>
        <em id="hub-world">…</em>
      </a>
      {
        calls.map((entry) => (
          <a class="hub-card" href={`/world/chat/${entry.data.slug}/`}>
            <span>chat</span>
            <strong style={`color:${entry.data.identity.color}`}>{text(entry.data.name)}</strong>
            <p>리더 통화.</p>
          </a>
        ))
      }
      <a class="hub-card" href="/world/brain">
        <span>brain</span>
        <strong>Brain</strong>
        <p>memory history를 봅니다.</p>
      </a>
      <a class="hub-card" href="/world/admin/album">
        <span>album</span>
        <strong>앨범</strong>
        <p>사진을 올리고 검토합니다.</p>
        <em id="hub-album">…</em>
      </a>
    </div>
    <form class="panel" id="tick-form">
      <p class="eyebrow">tick</p>
      <p class="world-copy">세계를 한 tick 진행합니다.</p>
      <div class="world-actions">
        <button type="button" id="tick-button">tick</button>
        <button type="button" id="sign-out">나가기</button>
      </div>
      <p class="world-status" id="auth-status" aria-live="polite"></p>
    </form>
  </div>
</Base>

<script>
  const status = document.querySelector('#auth-status');
  const tickButton = document.querySelector('#tick-button');
  const signOut = document.querySelector('#sign-out');
  const worldStatus = document.querySelector('#hub-world');
  const albumStatus = document.querySelector('#hub-album');

  function say(text) {
    status.textContent = text;
  }

  async function readJson(url) {
    const response = await fetch(url, { headers: { accept: 'application/json' } });
    if (response.status === 401 || response.status === 403) {
      location.replace('/login');
      return null;
    }
    if (!response.ok) return { error: true };
    return response.json().catch(() => ({ error: true }));
  }

  async function refresh() {
    const world = await readJson('/api/world');
    if (!world) return;
    worldStatus.textContent = world.error
      ? '연결 없음'
      : Number.isInteger(world.tick)
        ? `tick ${world.tick}`
        : 'tick 없음';
    const album = await readJson('/api/world/album');
    if (!album) return;
    if (album.error || !Array.isArray(album.submissions)) {
      albumStatus.textContent = '연결 없음';
      return;
    }
    const pending = album.submissions.filter(
      (row) => row && row.status !== 'published' && row.status !== 'rejected'
    ).length;
    albumStatus.textContent = `대기 ${pending}`;
  }

  tickButton.addEventListener('click', async () => {
    tickButton.disabled = true;
    say('Ticking.');
    try {
      const response = await fetch('/api/world/tick', {
        method: 'POST',
        headers: { accept: 'application/json' },
      });
      if (response.status === 409) say('A tick is already running.');
      else if (response.status === 401 || response.status === 403) location.replace('/login');
      else if (!response.ok) say('Unavailable.');
      else {
        const body = await response.json().catch(() => ({}));
        say(Number.isInteger(body.tick) ? `Tick ${body.tick}.` : 'Ticked.');
      }
    } catch {
      say('Unavailable.');
    }
    tickButton.disabled = false;
    await refresh().catch(() => {});
  });

  signOut.addEventListener('click', async () => {
    await fetch('/api/world/auth/session', { method: 'DELETE' }).catch(() => {});
    location.replace('/login');
  });

  refresh().catch(() => {
    worldStatus.textContent = '연결 없음';
    albumStatus.textContent = '연결 없음';
  });
</script>
