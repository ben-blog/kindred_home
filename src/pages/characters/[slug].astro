---
import { getCollection } from 'astro:content';
import BoardLayout from '../../components/character/BoardLayout.astro';
import SheetLayout from '../../components/character/SheetLayout.astro';
import VoidLayout from '../../components/character/VoidLayout.astro';
import Base from '../../layouts/Base.astro';
import { characterSurface } from '../../lib/character-layout.js';
import { text } from '../../lib/locale.js';
import { ogImageFor } from '../../lib/og.js';
import { compareEntries, isPublicStatus, worksForCharacter } from '../../lib/publish.js';

export async function getStaticPaths() {
  const characters = await getCollection('characters');
  return characters
    .filter((entry) => isPublicStatus(entry.data.status))
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry },
    }));
}

const layouts = {
  board: BoardLayout,
  void: VoidLayout,
  sheet: SheetLayout,
};

const { entry } = Astro.props;
const data = entry.data;
const surface = characterSurface(data);
const Layout = layouts[surface.layout] ?? SheetLayout;
const [works, relations, entities, characters] = await Promise.all([
  getCollection('works'),
  getCollection('relations'),
  getCollection('entities'),
  getCollection('characters'),
]);
const names = new Map(entities.map((item) => [item.data.slug, item.data.name]));
const notes = new Map(data.relationships.map((item) => [item.with, item.note]));
const page = {
  slug: data.slug,
  name: text(data.name),
  tagline: text(data.profile.tagline),
  bio: text(data.profile.bio),
  color: surface.accent,
  ground: surface.ground,
  ink: surface.ink,
  status: data.status,
  hub: data.aliases[0] || '',
  mark: data.identity.mark ?? null,
  works: worksForCharacter(data.slug, works)
    .sort(compareEntries)
    .map((work) => ({
      title: text(work.data.title),
      url: work.data.url,
    })),
  bonds: relations
    .filter((relation) => relation.data.from === data.slug || relation.data.to === data.slug)
    .sort((a, b) => a.data.id.localeCompare(b.data.id))
    .map((relation) => {
      const other = relation.data.from === data.slug ? relation.data.to : relation.data.from;
      const note = notes.get(other) ?? relation.data.note;
      return {
        name: names.get(other) ?? other,
        kinds: relation.data.kinds.join(' · '),
        note: text(note),
      };
    }),
  others: characters
    .filter((item) => isPublicStatus(item.data.status) && item.data.slug !== data.slug)
    .sort(compareEntries)
    .map((item) => ({
      name: text(item.data.name),
      href: `/characters/${item.data.slug}/`,
      color: item.data.identity.color,
    })),
};
---

<Base
  title={`${page.name} — kinxdred`}
  description={page.bio}
  accent={page.color}
  ground={page.ground}
  ink={page.ink}
  frame="character"
  image={ogImageFor(page.slug)}
  imageAlt={page.name}
>
  <Layout page={page} />
</Base>
