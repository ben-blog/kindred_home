---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { text } from '../../lib/locale.js';
import { isPublicStatus } from '../../lib/publish.js';

export async function getStaticPaths() {
  const campaigns = await getCollection('campaigns');
  return campaigns
    .filter((entry) => isPublicStatus(entry.data.status))
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const data = entry.data;
---

<Base title={`${text(data.title)} — kinxdred`} description={text(data.summary)}>
  <p class="eyebrow">
    {data.status} · {data.start} – {data.end}
  </p>
  <h1>{text(data.title)}</h1>
  <p>{text(data.summary)}</p>
  <a class="primary" href={data.cta.href}>{text(data.cta.label)}</a>
</Base>
