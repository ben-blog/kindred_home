---
export const prerender = false;
import { getCollection } from 'astro:content';
import Layout from '../../components/admin/Layout.astro';
import { text } from '../../lib/locale.js';
import { adminCopy as copy } from '../../lib/admin-copy.js';
import '../../styles/admin.css';
const people = (await getCollection('characters')).filter(({ data }) => data.status === 'active')
  .sort((a, b) => a.data.slug.localeCompare(b.data.slug));
const characters = people.map(({ data }) => ({ slug: data.slug, name: text(data.name), color: data.identity.color,
  gallery: data.aliases[0], chat: !!data.agent?.chat, memory: !!data.agent?.memory }));
---
<Layout title="Hub">
  <div class="head"><div><p class="eyebrow">leader hub</p><h1>Hub</h1></div><p class="status" id="world-status" aria-live="polite"><span class="dot"></span>{copy.loading}</p></div>
  <section class="panel tick" aria-labelledby="tick-title">
    <div><p class="eyebrow">next tick</p><h2 id="tick-title">{copy.tickTitle}</h2><ul id="tick-preview"></ul><p id="empty-warmth" class="hint"></p></div>
    <div class="tick-go"><button class="btn primary" data-tick disabled>Tick 진행</button><p class="hint">{copy.irreversible}</p></div>
  </section>
  <div class="chars" id="characters" data-characters={JSON.stringify(characters)}>
    {characters.map((person) => <article class="panel char" data-character={person.slug} style={`--accent:${person.color}`}>
      <div class="char-top"><div><span class="char-name">{person.name}</span><span class="face" hidden>피곤한 표정</span></div><span class="where"></span></div>
      <div data-gauges></div><div class="xp" data-xp></div>
      <div class="pending"><span data-pending>{copy.loading}</span><span class="mono hint" data-warmth-note hidden aria-live="polite"></span></div>
      <div class="char-actions" data-warmth={person.slug} data-note-sent={copy.sent} data-note-wait={copy.wait} data-note-fail={copy.warmthFail}>
        <button class="btn accent" disabled>Warmth +1</button>
        {person.chat && <a class="btn ghost" href={`/world/chat/${person.slug}/`}>채팅</a>}
        {person.memory && <a class="btn ghost" href={`/world/brain/${person.slug}/`}>Brain</a>}
      </div>
    </article>)}
  </div>
  <p class="legend"><span><i class="legend-now"></i>지금</span><span><i class="legend-next"></i>tick 후 예상</span><span id="rule-note"></span></p>
  <div class="lower">
    <section class="panel sec" aria-labelledby="q-title"><div class="sec-head"><div><p class="eyebrow">album review</p><h3 id="q-title">{copy.queue}</h3></div><span class="count" id="queue-count"></span></div><ul class="q" id="review-queue"></ul></section>
    <div class="side">
      <a class="panel link-card" href="/world/admin/album"><span><span class="eyebrow">album</span><br/><strong>{copy.albumManage}</strong></span><span class="go">→</span><p>{copy.albumDescription}</p></a>
      <section class="panel sec"><p class="eyebrow">gallery</p><div class="chips" id="gallery-chips">{characters.filter((person) => person.gallery).map((person) => <a class="chip" href={person.gallery}>{person.name} 갤러리</a>)}</div></section>
      <section class="panel sec"><p class="eyebrow">bonds</p><div class="chips" id="bonds"></div></section>
    </div>
  </div>
  <div class="error" id="error-bar" hidden role="alert"><span data-admin-message></span><button class="btn small ghost" id="retry">{copy.retry}</button></div>
  <p class="world-status" id="action-status" role="status"></p>
  <div class="foot"><span>Ben · 로그인됨</span><span id="updated-at"></span></div>
  <div slot="bottom" class="mobile-tick"><div class="sum" id="mobile-summary">{copy.loading}</div><button class="btn primary" data-tick disabled>Tick 진행</button></div>
</Layout>
<script src="../../scripts/admin-hub.js"></script>
