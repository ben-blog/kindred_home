---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CharacterMark from '../../components/CharacterMark.astro';
import { text } from '../../lib/locale.js';
import { compareEntries, isPublicStatus, worksForCharacter } from '../../lib/publish.js';

export async function getStaticPaths() {
  const characters = await getCollection('characters');
  return characters
    .filter((entry) => isPublicStatus(entry.data.status))
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const data = entry.data;
const [works, relations, entities] = await Promise.all([
  getCollection('works'),
  getCollection('relations'),
  getCollection('entities'),
]);
const names = new Map(entities.map((item) => [item.data.slug, item.data.name]));
const relatedWorks = worksForCharacter(data.slug, works).sort(compareEntries);
const bonds = relations
  .filter((relation) => relation.data.from === data.slug || relation.data.to === data.slug)
  .sort((a, b) => a.data.id.localeCompare(b.data.id));
const hub = data.aliases[0];
const notes = new Map(data.relationships.map((item) => [item.with, item.note]));
---

<Base title={`${text(data.name)} — kinxdred`} description={text(data.profile.bio)} accent={data.identity.color}>
  <header class="character-hero">
    <p class="eyebrow">
      {data.status === 'archived' ? <span class="status-archived">archived</span> : data.status}
      {data.agent ? ` · ${data.agent.service}` : ''}
    </p>
    <div class="hero-name">
      <CharacterMark mark={data.identity.mark} />
      <h1>{text(data.name)}</h1>
    </div>
    <p>{text(data.profile.tagline)}</p>
  </header>
  <p class="swatch"><i></i> {data.identity.color}</p>
  <p>{text(data.profile.bio)}</p>
  {hub ? <a class="primary" href={hub}>Open {hub}</a> : null}

  <h2>Works</h2>
  <ul class="links">
    {
      relatedWorks.map((work) => (
        <li>
          <a href={work.data.url}>
            <span>{text(work.data.title)}</span>
            <span class="meta">{work.data.url}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>Relationships</h2>
  <ul class="bonds">
    {
      bonds.map((relation) => {
        const other = relation.data.from === data.slug ? relation.data.to : relation.data.from;
        return (
          <li class="card">
            <span>
              {names.get(other) ?? other}
              <span class="note"> · {relation.data.kinds.join(' · ')}</span>
              {text(notes.get(other) ?? relation.data.note) ? (
                <span class="note"> — {text(notes.get(other) ?? relation.data.note)}</span>
              ) : null}
            </span>
            {relation.data.kinds.includes('썸') && typeof relation.data.tension === 'number' ? (
              <span class="meta">tension {relation.data.tension}</span>
            ) : null}
          </li>
        );
      })
    }
  </ul>
</Base>

<style>
  .character-hero {
    container-type: inline-size;
    --mark-size: clamp(11rem, 47cqi, 21rem);
  }

  .hero-name {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    min-height: calc(var(--mark-size) * .72);
  }

  .hero-name h1 {
    position: relative;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(44px, 8.5vw, 116px);
    letter-spacing: -.02em;
    paint-order: stroke fill;
    -webkit-text-stroke: .035em var(--black);
    pointer-events: none;
  }
</style>
