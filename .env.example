# Upstream origins for /api/event. https origin only, no path.
# Set the values in Vercel. An empty line fails closed with 503.

KIN_AGENT_URL=
DRED_AGENT_URL=
MIRRORED_API_URL=

# Bearer for the agent. Event posts omit it when empty.
# Leader chat requires it and sends it as Authorization and X-Admin-Key.
# Set each value to that Railway service's ADMIN_API_KEY. Never expose it to the browser.
KIN_AGENT_TOKEN=
DRED_AGENT_TOKEN=
MIRRORED_API_TOKEN=

# Persistent world. Server only. Never expose these to the browser.
# A missing or unsafe value makes every /api/world route fail closed with 503.
# Apply supabase/migrations/20261122120000_world.sql on kinxdred_home before use.

WORLD_SUPABASE_URL=
WORLD_SUPABASE_SERVICE_KEY=
WORLD_SUPABASE_ANON_KEY=
WORLD_LEADER_USER_ID=
WORLD_IP_SALT=
CRON_SECRET=

# Vision captions for /world/admin/album. Server only. Never expose this to the browser.
# Missing or unsafe: caption routes say so, and the picture stays a draft until it is set.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6. Set a vision-capable model if that name is rejected.
ANTHROPIC_ALBUM_MODEL=
